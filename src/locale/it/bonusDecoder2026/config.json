{
    "templates": {
        "categories": [
            {
                "value": "DS",
                "label": "templates.categories.ds"
            },
            {
                "value": "DT",
                "label": "templates.categories.dt"
            },
            {
                "value": "DTC",
                "label": "templates.categories.dtc"
            },
            {
                "value": "DTS",
                "label": "templates.categories.dts"
            },
            {
                "value": "DTSC",
                "label": "templates.categories.dtsc"
            }
        ]
    },
    "pages": {
        "products": {
            "drawer": [
                {
                    "field": "category",
                    "headerName": "pages.products.drawer.category",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "brand",
                    "headerName": "pages.products.drawer.brand",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "model",
                    "headerName": "pages.products.drawer.model",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "gtinCode",
                    "headerName": "pages.products.drawer.gtinCode",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "productCode",
                    "headerName": "pages.products.drawer.productCode",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                }
            ],
            "productsTable": {
                "filters": [
                    {
                        "id": "category",
                        "type": "select",
                        "label": "pages.products.filters.category",
                        "template": "categories"
                    },
                    {
                        "id": "brand",
                        "type": "text",
                        "label": "pages.products.filters.brand"
                    },
                    {
                        "id": "model",
                        "type": "text",
                        "label": "pages.products.filters.model"
                    },
                    {
                        "id": "productCode",
                        "type": "text",
                        "label": "pages.products.filters.productCode",
                        "regEx": "^[a-zA-Z0-9]{1,100}$",
                        "message": "pages.products.filters.errors.productCode",
                        "pattern": {
                            "value": "\\s+",
                            "flag": "g"
                        }
                    },
                    {
                        "id": "gtinCode",
                        "type": "text",
                        "label": "pages.products.filters.gtinCode",
                        "regEx": "^[a-zA-Z0-9]{1,14}$",
                        "message": "pages.products.filters.errors.gtinCode",
                        "pattern": {
                            "value": "\\s+",
                            "flag": "g"
                        },
                        "inputProps": {
                            "maxLength": 14
                        }
                    }
                ],
                "columns": [
                    {
                        "field": "category",
                        "headerName": "pages.products.tableHeaders.category",
                        "flex": 1,
                        "sortable": true,
                        "disableColumnMenu": true,
                        "resizable": false,
                        "cell": {
                            "type": "text",
                            "tooltip": true
                        }
                    },
                    {
                        "field": "brand",
                        "headerName": "pages.products.tableHeaders.brand",
                        "flex": 1,
                        "sortable": true,
                        "disableColumnMenu": true,
                        "resizable": false,
                        "cell": {
                            "type": "text",
                            "tooltip": true
                        }
                    },
                    {
                        "field": "model",
                        "headerName": "pages.products.tableHeaders.model",
                        "flex": 1,
                        "sortable": true,
                        "disableColumnMenu": true,
                        "resizable": false,
                        "cell": {
                            "type": "text",
                            "tooltip": true
                        }
                    },
                    {
                        "field": "gtinCode",
                        "headerName": "pages.products.tableHeaders.gtinCode",
                        "flex": 1,
                        "sortable": true,
                        "disableColumnMenu": true,
                        "resizable": false,
                        "cell": {
                            "type": "text",
                            "tooltip": true
                        }
                    },
                    {
                        "field": "productCode",
                        "headerName": "pages.products.tableHeaders.productCode",
                        "flex": 1,
                        "sortable": true,
                        "disableColumnMenu": true,
                        "resizable": false,
                        "cell": {
                            "type": "text",
                            "tooltip": true
                        }
                    },
                    {
                        "field": "action",
                        "sortable": false,
                        "filterable": false,
                        "disableColumnMenu": true,
                        "flex": 0.5,
                        "cell": {
                            "type": "action"
                        }
                    }
                ]
            }
        },
        "purchaseManagement": {
            "drawer": [
                {
                    "field": "trxChargeDate",
                    "headerName": "pages.purchaseManagement.drawer.trxDate",
                    "cell": {
                        "type": "date",
                        "tooltip": true,
                        "bold": true,
                        "options": {
                            "day": "2-digit",
                            "month": "2-digit",
                            "year": "numeric",
                            "hour": "2-digit",
                            "minute": "2-digit"
                        }
                    }
                },
                {
                    "field": "additionalProperties.productName",
                    "headerName": "pages.purchaseManagement.drawer.householdAppliance",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "fiscalCode",
                    "headerName": "pages.purchaseManagement.drawer.fiscalCode",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "id",
                    "headerName": "pages.purchaseManagement.drawer.transactionId",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "trxCode",
                    "headerName": "pages.purchaseManagement.drawer.trxCode",
                    "cell": {
                        "type": "text",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "effectiveAmountCents",
                    "headerName": "pages.purchaseManagement.drawer.totalAmount",
                    "cell": {
                        "type": "euro",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "rewardAmountCents",
                    "headerName": "pages.purchaseManagement.drawer.rewardAmount",
                    "cell": {
                        "type": "euro",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "residualAmountCents",
                    "headerName": "pages.purchaseManagement.drawer.authorizedAmount",
                    "cell": {
                        "type": "euro",
                        "tooltip": true,
                        "bold": true
                    }
                },
                {
                    "field": "status",
                    "headerName": "pages.purchaseManagement.drawer.status",
                    "cell": {
                        "type": "chip",
                        "tooltip": true,
                        "bold": true,
                        "context": "commons.statusEnum.transaction.purchase"
                    }
                },
                {
                    "field": "trxCode",
                    "headerName": "pages.purchaseManagement.drawer.document",
                    "cell": {
                        "type": "download",
                        "tooltip": true,
                        "bold": true
                    }
                }
            ]
        }
    }
}