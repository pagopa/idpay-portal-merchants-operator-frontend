                    },
                    {
                        "id": "model",
                        "type": "text",
                        "label": "pages.products.filters.model"
                    },
                    {
                        "id": "eprelCode",
                        "type": "text",
                        "label": "pages.products.filters.eprelCode",
                        "regEx": "^[0-9]{1,12}$",
                        "message": "pages.products.filters.errors.eprelCode",
                        "pattern": {
                            "value": "\\s+",
                            "flag": "g"
                        },
                        "inputProps": {
                            "maxLength": 12
                        }
                    },
                    {
                        "id": "gtinCode",
                        "type": "text",
                        "label": "pages.products.filters.gtinCode",
                        "regEx": "^[a-zA-Z0-9]{1,14}$",
                        "message": "pages.products.filters.errors.gtinCode",
                        "pattern": {
                            "value": "\\s+",
                            "flag": "g"
                        },
                        "inputProps": {
                            "maxLength": 14
                        }
                    }
                ],
